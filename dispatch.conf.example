# =====================================================================
#  File Dispatcher - single configuration file
#  Copy this file to "dispatch.conf" and edit it. That's the only file
#  you need to touch. Lines starting with # are comments.
#
#  Sections:  (1) Settings   (VALIDATION)   (2) Variables   (3) Rules
#
#  Style used below: string literals are always "quoted"; $field
#  references stay bare; numbers are bare. Quoting a simple value is
#  optional -- "report" and report are the same -- but quotes are
#  REQUIRED when a value contains spaces or commas.
#
#  How to run:
#    ./dispatch.sh --check     validate this config, then exit (0 = OK)
#    ./dispatch.sh --dry-run   move NOTHING, but log exactly the lines a real
#                              run would write (same STATUS, same action, same
#                              fields), each prefixed with "DRY-RUN".
#                              Destinations are checked too (does the directory
#                              exist / could it be created / is it writable?),
#                              so a target cron could not write to shows up as
#                              "would FAIL" instead of a move that would fail.
#    ./dispatch.sh --debug     verbose trace: field values, variables, and the
#                              rule resolution step by step.
#    ./dispatch.sh             process for real (this is what cron runs)
#
#  Pointing at this file: any of the commands above accept
#    --config-file /path/to/dispatch.conf     (or the $DISPATCH_CONFIG env var).
#  With neither, the script uses "dispatch.conf" next to the script itself.
# =====================================================================


# --- 1) SETTINGS -----------------------------------------------------
# Where incoming files arrive (each data file + its <base>.json sidecar).
INCOMING_DIR     = "/data/incoming"

# Single directory where every processed .json is archived (flat).
JSON_ARCHIVE_DIR = "/data/archive/json"

# Logs directory. Two files are written inside it:
#   dispatch.log  - every action, at every level
#   errors.log    - real failures only (the ERROR lines): something did not
#                   happen and needs a look. This is the one to watch.
#                   Warnings -- a file no rule claimed, a duplicate setting --
#                   stay in dispatch.log. Both still print to stderr.
LOG_DIR          = "/data/logs"

# (optional) A file must stay unchanged for this many seconds (its I/O
# must have settled) before it is processed. Guards against files that
# are still being copied. Default: 2.
STABLE_SECONDS   = 2

# (optional) Create a destination directory when it does not exist?
#   no  (default) a missing destination is an ERROR: the file is left in place
#                 and the run says so. Safe: a typo in a rule, or a field that
#                 came through empty, fails loudly instead of quietly building
#                 a new tree somewhere.
#   yes           missing destinations are created (makedirs).
# --dry-run follows this setting, so it reports what a real run would do.
# LOG_DIR and JSON_ARCHIVE_DIR are the tool's own directories, not routing
# targets, and are created either way.
CREATE_DIRS      = no

# (optional) Also handle a data file that has NO <base>.json sidecar?
#   no  (default) it is not ready yet -- the producer announces a file by
#                 writing both halves -- so it waits for a later run.
#   yes           it becomes a unit of work of its own, matched on the system
#                 fields below alone (every other $field is empty), and moved
#                 with nothing to archive (the log ends archived='-').
#                 REQUIRED does not apply to such a file -- it states what a
#                 sidecar must provide, and there is none to hold to it.
# WARNING: if your producer writes the data file first and its .json a moment
# later, "yes" can dispatch the data before the sidecar lands, orphaning it.
# Turn it on only for files that genuinely arrive alone, or raise
# STABLE_SECONDS past the gap between the two writes.
DISPATCH_WITHOUT_JSON = no

# --- SYSTEM FIELDS ---------------------------------------------------
# Three fields come from the filesystem rather than the sidecar, and are
# available to every rule and variable, sidecar or not:
#   $Filename      base name with extension          "orders-42.csv"
#   $Filesize      size in bytes, as digits          "10485760"   (< > <= >= work)
#   $Filedatetime  mtime, local, YYYY-MM-DDTHH:MM:SS "2026-09-02T13:31:20"
# A sidecar field of the same name WINS -- these only fill in what it does not
# say. --debug labels each one "json field:" or "system field:".
#     $Filename ENDSWITH ".csv"           => "$OUT/csv"
#     $Filesize > "10000000"              => "$OUT/large"
#     $Filedatetime STARTSWITH "2026-09"  => "$OUT/2026-09"

# (optional) The two run-mode flags, so they can live in the config instead of
# being typed on every invocation. The COMMAND LINE WINS: --dry-run / --debug
# turn them on, --no-dry-run / --no-debug turn them off, and the settings below
# are consulted only when neither flag is given -- so a config left on
# DRY_RUN = yes can never silently swallow a real run.
DRY_RUN          = no
DEBUG            = no

# (optional) Path to the Python 3 interpreter used by the engine.
# Leave it out to use "python3" from PATH (or the $DISPATCH_PYTHON env var).
# PYTHON         = "/usr/bin/python3"


# --- VALIDATION (optional) -------------------------------------------
# Before anything else, require these JSON fields to be present AND
# non-empty. If any is missing or empty, the file is left in place and
# an ERROR is logged. Leave it out to disable validation.
# (These are field references, so they stay bare.)
# An explicit null ("status": null) counts as PRESENT and passes; a field
# that is absent or set to "" does not. Use ISNULL to test for it.
# This is a contract on what the SIDECAR must provide, so a file dispatched
# without one (see DISPATCH_WITHOUT_JSON) is not checked against it.
REQUIRED = $category, $group


# --- 2) VARIABLES ----------------------------------------------------
# "$name" means "the value of name". Every field of the current JSON is
# available as a value: $category, $group, ... You can also DEFINE your
# own values with "NAME = ..." (like a shell variable: NAME= to set,
# $NAME to use). Definitions are evaluated top to bottom, so a variable
# may reuse the ones above it.
OUT     = "/data/out"
GROUP   = "$group"
REPORTS = "$OUT/Annual Reports"        # quotes -> spaces are fine; $ still expands
TARGET  = $group"/"$category           # concatenation -> "<group>/<category>"
TARGET  = $group + "/" + $category     # same thing, written with "+"
#
# "+" joins values explicitly and swallows the spaces around it. It works in
# variables, in both branches of a ternary, in a rule destination, and on the
# RIGHT side of a condition. Outside quotes it is always the operator, so write
# "+" when you need a literal plus. The LEFT side of a condition stays a bare
# $field (no "+", no function) -- normalize with a variable instead:
#     ST = upper($status)
#     $ST CONTAINS "DONE"  => $BASE + "/done"
#
# A value can also be a Python-style ternary:  A if <condition> else B
# The <condition> uses the same operators as rules. Ternaries chain like if/elif/else.
# Functions available in a value: int(...), upper(...), lower(...).
TEAM    = "core" if $unit = "central" else $unit
TIER    = "gold" if $vip = "yes" else "silver" if $amount = "high" else "std"
SHARD   = int($id)                     # e.g. "007" -> "7"
#
# More ternary patterns (the <condition> uses the SAME operators as rules):
#   binary          A if <cond> else B
#   chained (elif)  A if <c1> else B if <c2> else C
#   no else         A if <cond>            -- see "conditional assignment" below
#   the condition may use =, !=, <>, numeric < > <= >=, STARTSWITH/ENDSWITH/
#   CONTAINS, IN (...), AND / OR, and ( ) grouping; branches may be literals,
#   $fields, functions int()/upper()/lower(), or concatenations.
ENVDIR  = "prod" if $env = "production" else "staging" if $env = "stage" else "dev"
SIZEDIR = "xl" if $bytes >= "1000000" else "l" if $bytes >= "1000" else "s"   # numeric
CHANNEL = "billing" if $type IN ("invoice", "credit", "debit") else "general" # IN
INOUT   = "inbound" if $filename STARTSWITH "IN-" else "outbound"             # STARTSWITH
ALERT   = "urgent" if $note CONTAINS "URGENT" else "normal"                   # CONTAINS
ZONE    = "priority" if $vip = "yes" OR $tier = "gold" else "standard"        # OR
SECURE  = "restricted" if ($region = "EU" AND $pii = "yes") else "open"       # AND + ( )
ORG     = "core" if $bu = "central" else upper($bu)       # function in a branch
OWNER   = $owner if $owner != "" else "unassigned"        # fill-in-a-default pattern
BUCKET  = $group"/"$category if $group != "" else "misc"  # concatenation in a branch
#
# --- Conditional assignment: the "else" is OPTIONAL ------------------
# Written without an else, an assignment only fires when its condition holds;
# otherwise the variable KEEPS the value it already had. So several lines about
# the same variable read like if / elif, instead of the last one always winning:
#
#     APP = "reports"  if $ST CONTAINS "REPORT"     # first match sets it ...
#     APP = "invoices" if $ST CONTAINS "INVOICE"    # ... a later one overrides
#
# With no line matching, the variable holds "" (or whatever it was set to
# earlier). Guard it if an empty value would build a broken path -- either seed
# a default first, or end the chain with a plain else:
#
#     APP = "misc"                                  # default, then refine
#     APP = "reports"  if $ST CONTAINS "REPORT"
#
# Reading order matters: definitions are evaluated top to bottom, so a variable
# must be defined ABOVE the line that uses it. Using one too early is not an
# error -- it simply reads as "" and leaves an empty segment in the path.
ST      = upper($status)                # normalize once, test many times
STAGE   = "prod"                        # a default ...
STAGE   = "staging" if $env = "stage"   # ... refined only when it applies
STAGE   = "dev"     if $env = "dev"


# --- 3) RULES --------------------------------------------------------
# A rule is:   <condition> => "<destination directory>"
#
#   condition atoms:
#       $field = "value"                  equality (value may contain wildcards; == also works)
#       $field != "value"                 not equal (or <>)
#       $field < / > / <= / >= "10"       numeric comparison (non-numbers never match)
#       $field STARTSWITH / ENDSWITH / CONTAINS "s"   substring tests
#       $field IN ("a", "b", "c")         membership (any of the values)
#   combine atoms with AND / OR           (AND is evaluated before OR)
#   group with parentheses ( ... )        ( ) > AND > OR, e.g.
#       ($a = "x" OR $a = "y") AND $b = "z" => ...
#   wildcard "*" inside a value           matches any run of characters:
#                                         "invoice*", "*credit", "*" (= any value)
#   the destination may use values too:   $OUT, $GROUP, $category, ...
#
# The FIRST rule that matches wins. If no rule matches, the file is left
# in place and a "no rule matched" line is logged.
#
# ---- Rule cookbook (edit / delete freely) ---------------------------
# The examples below are grouped by feature. They are meant to be read,
# copied, and adapted -- not all kept at once (remember: FIRST match wins,
# so order matters and the catch-all at the very bottom would shadow any
# rule placed after it). Every line is a valid, ready-to-run rule.

# --- a) Equality ( = / == ) ------------------------------------------
# category "report" goes under its group's reports folder.
$category = "report"                              => "$OUT/$GROUP/reports"
# == is an accepted spelling of =.
$type == "invoice"                                => "$OUT/$GROUP/billing"
# Compare a field to ANOTHER field (the right side may be a $reference).
$owner = $group                                   => "$OUT/$GROUP/self-owned"

# --- b) Wildcards ( * matches any run of characters ) ----------------
# starts with "arch" (archive, archived, archival, ...).
$category = "arch*"                               => "$OUT/$GROUP/archive"
# ends with "-eu".
$region = "*-eu"                                  => "$OUT/eu"
# has "temp" somewhere in the middle.
$name = "*temp*"                                  => "$OUT/tmp"
# "*" on its own matches ANY (non-empty) value -> a per-field bucket.
$vendor = "*"                                     => "$OUT/vendors/$vendor"

# --- c) Not equal ( != / <> ) ----------------------------------------
# everything whose status is NOT "done".
$status != "done"                                 => "$OUT/$GROUP/open"
# <> is an accepted spelling of !=; wildcards work here too.
$name <> "draft-*"                                => "$OUT/$GROUP/final"

# --- d) Numeric comparison ( < > <= >= ) -----------------------------
# both sides are read as numbers; a non-numeric value never matches.
$amount >= "10000"                                => "$OUT/$GROUP/large"
$amount < "100"                                   => "$OUT/$GROUP/small"
$priority <= "3"                                  => "$OUT/$GROUP/high-priority"
# a numeric window, using AND (see below).
$score >= "50" AND $score < "80"                  => "$OUT/$GROUP/mid-band"

# --- e) String predicates ( STARTSWITH / ENDSWITH / CONTAINS ) -------
# plain substring tests (no wildcards, just literal text).
$filename STARTSWITH "INV-"                       => "$OUT/$GROUP/invoices"
$filename ENDSWITH ".pdf"                         => "$OUT/$GROUP/pdf"
$note CONTAINS "URGENT"                           => "$OUT/$GROUP/urgent"

# --- e2) Null fields ( ISNULL / ISNOTNULL ) --------------------------
# A JSON null reads as "" like an empty field, so these operators are the only
# way to tell "the producer sent null" from "empty" or "absent". They take NO
# right-hand side. REQUIRED accepts an explicit null too ("" and absent do not).
$status ISNULL                                    => "$OUT/unset"
$status ISNOTNULL                                 => "$OUT/set"
# works in a ternary condition as well:
# KIND = "none" if $status ISNULL else lower($status)

# --- f) Membership ( IN (...) ) --------------------------------------
# several values share one destination.
$category IN ("invoice", "credit", "debit")       => "$OUT/$GROUP/billing"
# items may be wildcards too.
$ext IN ("*.csv", "*.tsv", "*.txt")               => "$OUT/$GROUP/text"
# quotes let values contain spaces or commas.
$status IN ("in progress", "on hold")             => "$OUT/$GROUP/pending files"

# --- g) Boolean logic ( AND / OR ) -----------------------------------
# AND: an export whose status is new or retry.
$type = "export" AND $status IN ("new", "retry")  => "$OUT/exports"
# OR: either a high priority or an urgent flag.
$priority = "high" OR $flag = "urgent"            => "$OUT/$GROUP/urgent"
# AND binds tighter than OR: reads as  A OR (B AND C).
$vip = "yes" OR $tier = "gold" AND $region = "US" => "$OUT/$GROUP/premium"

# --- h) Grouping ( ( ... ) overrides AND-before-OR ) -----------------
# both "order" and "refund" must ALSO be in the EU region.
($category = "order" OR $category = "refund") AND $region = "EU" => "$OUT/eu"
# a nested example.
($type = "export" OR $type = "sync") AND ($env = "prod" OR $env = "stage") => "$OUT/pipeline"

# --- i) Destinations built from fields / variables -------------------
# the right-hand side is a value expression: mix literals, $fields, $vars.
$kind = "*"                                       => "$OUT/$GROUP/$kind"
# use a variable defined above (TARGET = $group"/"$category).
$category = "order"                               => "$OUT/$TARGET"
# spaces and commas in the destination need quotes.
$category = "annual"                              => "$REPORTS"

# --- j) A catch-all fallback (KEEP THIS LAST) ------------------------
# Nothing above matched? Send it to a review folder instead of leaving
# it in place. Delete this line if you prefer "no match => left alone".
$kind = "*"                                       => "$OUT/_unsorted"
